---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets'; // For future CF Images optimization

// Placeholder images - TODO: Replace ALL with Cloudflare Images CDN URLs for global edge performance
// Example CF URL: https://imagedelivery.net/<ACCOUNT_ID>/<IMAGE_ID>/public
const heroImage = "/images/50-poster.jpg"; // Custom generated cinematic key art — replace with Cloudflare Images CDN URL in production for global edge delivery
const scriptImage = "https://images.unsplash.com/photo-1455390582262-044cdead277a?w=800&q=80";
const desertImage = "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=80";
const summerImage = "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=800&q=80";
const filmReelImage = "https://images.unsplash.com/photo-1485846234645-a62644f84728?w=800&q=80";
---

<Layout>
  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-[#0a0a0a]/95 backdrop-blur-lg border-b border-white/10">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <div class="flex items-center gap-x-3">
        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-[#d4af37] to-[#b8972e] flex items-center justify-center">
          <span class="text-[#0a0a0a] font-bold text-xl tracking-tighter">50</span>
        </div>
        <div>
          <div class="font-semibold tracking-[3px] text-sm">50 GOOD SUMMERS</div>
          <div class="text-[10px] text-[#d4af37]/70 -mt-1">A CINEMATIC STORY</div>
        </div>
      </div>

      <div class="hidden md:flex items-center gap-x-10 text-sm tracking-widest">
        <a href="#premise" class="hover:text-[#d4af37] transition-colors">THE PREMISE</a>
        <a href="#story" class="hover:text-[#d4af37] transition-colors">THE STORY</a>
        <a href="#development" class="hover:text-[#d4af37] transition-colors">DEVELOPMENT</a>
      </div>

      <a 
        href="mailto:sales@desertrich.com?subject=Acquisition%20Inquiry%20-%2050%20Good%20Summers"
        class="hidden md:block px-6 py-2.5 text-xs tracking-[2px] border border-[#d4af37] text-[#d4af37] hover:bg-[#d4af37] hover:text-[#0a0a0a] transition-all rounded-full font-medium"
      >
        ACQUIRE RIGHTS
      </a>

      <!-- Mobile menu -->
      <button id="mobile-menu-btn" class="md:hidden text-[#d4af37]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden film-grain">
    <!-- Background Image with overlay -->
    <div class="absolute inset-0 z-0">
      <img 
        src={heroImage} 
        alt="Cinematic desert landscape at golden hour — symbolizing the precious, fleeting nature of 50 good summers"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/70 to-black/90"></div>
      <div class="absolute inset-0 bg-[radial-gradient(#d4af37_0.8px,transparent_1px)] bg-[length:4px_4px] opacity-10"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-x-2 px-4 py-1 rounded-full border border-[#d4af37]/40 mb-8">
        <div class="w-2 h-2 bg-[#d4af37] rounded-full animate-pulse"></div>
        <span class="uppercase tracking-[3px] text-xs text-[#d4af37]">IN ACTIVE DEVELOPMENT</span>
      </div>

      <h1 class="text-[72px] md:text-[96px] leading-[0.92] font-bold tracking-tighter mb-6 text-balance">
        50 GOOD<br>SUMMERS
      </h1>

      <p class="tagline max-w-2xl mx-auto mb-12 text-[#e8d5a3]">
        "As long as you live and how you live,<br>you are only granted 50 good summers,<br>no more, no less."
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="#acquire"
          class="cta-button group inline-flex items-center justify-center gap-x-3 px-10 py-4 rounded-full text-sm tracking-[2px]"
        >
          ACQUIRE THE SCRIPT
          <span class="group-hover:rotate-45 transition-transform">↗</span>
        </a>
        
        <a 
          href="#story" 
          class="inline-flex items-center justify-center gap-x-3 px-8 py-4 rounded-full border border-white/30 hover:bg-white/5 text-sm tracking-widest transition-all"
        >
          DISCOVER THE STORY
        </a>
      </div>
    </div>

    <!-- Scroll prompt -->
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-y-1 text-xs tracking-[3px] text-white/50">
      <span>SCROLL TO BEGIN</span>
      <div class="scroll-indicator w-px h-8 bg-gradient-to-b from-transparent via-white/60 to-transparent"></div>
    </div>
  </section>

  <!-- THE PREMISE -->
  <section id="premise" class="max-w-5xl mx-auto px-6 pt-24 pb-20">
    <div class="grid md:grid-cols-12 gap-x-8 items-center">
      <div class="md:col-span-5 mb-12 md:mb-0">
        <div class="sticky top-24">
          <div class="uppercase tracking-[3px] text-xs text-[#d4af37] mb-3">CHAPTER I</div>
          <h2 class="text-6xl md:text-7xl leading-none tracking-tighter font-bold mb-8">THE<br>PREMISE</h2>
          
          <div class="gold-line w-20 mb-8"></div>
          
          <p class="text-xl text-[#c9b89a] leading-tight">
            Life grants us a finite number of perfect summers.<br>
            This is the story of a man who refuses to waste a single one.
          </p>
        </div>
      </div>

      <div class="md:col-span-7">
        <div class="prose prose-invert max-w-none text-[17px] leading-relaxed text-[#d1c7b0]">
          <p class="mb-8">
            <span class="font-semibold text-[#d4af37]">50 Good Summers</span> is a meditative, emotionally devastating, and ultimately life-affirming feature film screenplay about the quiet mathematics of a life well-lived.
          </p>
          
          <p class="mb-8">
            At its core lies a simple, haunting truth: from the moment we are born, we are allotted roughly <span class="font-semibold">fifty summers</span> on this earth. Some are golden. Most are ordinary. A few are lost forever.
          </p>

          <div class="bg-[#111] border-l-4 border-[#d4af37] pl-8 py-1 my-10">
            <p class="italic text-[#d4af37]/90 text-[21px] leading-tight">
              "The question is not how many summers you have left.<br>
              The question is: will they be good ones?"
            </p>
          </div>

          <p>
            Set against the vast, unforgiving beauty of the American Southwest, the story follows a man confronting the finite nature of time — and the infinite possibilities that remain if he chooses to live deliberately.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider max-w-5xl mx-auto"></div>

  <!-- THE STORY -->
  <section id="story" class="max-w-5xl mx-auto px-6 py-24">
    <div class="text-center mb-16">
      <div class="uppercase tracking-[4px] text-xs text-[#d4af37] mb-4">CHAPTER II</div>
      <h2 class="text-6xl md:text-[68px] leading-none tracking-[-3.5px] font-bold">THE STORY</h2>
    </div>

    <div class="max-w-3xl mx-auto text-center mb-16">
      <p class="text-2xl md:text-3xl leading-tight text-[#d1c7b0] font-light tracking-tight">
        A man in his late forties receives a devastating medical prognosis. 
        With perhaps a decade of summers remaining, he embarks on a final, 
        desperate pilgrimage to reclaim the ones he let slip away — 
        and to ensure the ones ahead are unforgettable.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Logline Card -->
      <div class="cinematic-card bg-[#111] p-10 border border-white/10 rounded-3xl">
        <div class="uppercase text-xs tracking-[2px] text-[#d4af37] mb-4">LOGLINE</div>
        <p class="text-[21px] leading-tight font-light">
          When a man learns he has only a handful of summers left, he sets out to transform his remaining time into a legacy of meaning — before the sun sets on his final season.
        </p>
      </div>

      <!-- Visual Teaser -->
      <div class="relative overflow-hidden rounded-3xl aspect-[16/10] border border-white/10">
        <img 
          src={scriptImage} 
          alt="Vintage typewriter with handwritten screenplay pages — the physical embodiment of 50 Good Summers"
          class="absolute inset-0 w-full h-full object-cover grayscale-[0.3]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-10">
          <div class="text-xs tracking-[2px] text-[#d4af37]">ORIGINAL SCREENPLAY</div>
          <div class="text-3xl font-semibold tracking-tight mt-1">118 PAGES</div>
        </div>
      </div>
    </div>

    <div class="mt-16 max-w-3xl mx-auto text-[#b8ad95] text-[15px] leading-relaxed space-y-6">
      <p>
        The narrative unfolds across three timelines: the protagonist’s childhood summers of wonder, the reckless summers of his twenties, and the urgent, luminous summers of his present — all converging toward one final, transcendent season.
      </p>
      <p>
        It is a love letter to the American landscape, to second chances, and to the radical idea that it is never too late to live a life of intention.
      </p>
    </div>
  </section>

  <!-- VISUAL LANGUAGE -->
  <section class="bg-[#111] py-20 border-y border-white/10">
    <div class="max-w-5xl mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-end gap-8 mb-12">
        <div>
          <div class="uppercase tracking-[3px] text-xs text-[#d4af37]">CHAPTER III</div>
          <h3 class="text-5xl tracking-tight font-bold">VISUAL LANGUAGE</h3>
        </div>
        <p class="max-w-md text-[#b8ad95]">Shot on 35mm film. Golden hour obsession. The desert as both antagonist and sanctuary.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="group relative overflow-hidden rounded-2xl aspect-video border border-white/10">
          <img src={desertImage} alt="Vast golden desert dunes at sunset — the primary visual motif of 50 Good Summers" class="w-full h-full object-cover transition-transform group-hover:scale-105 duration-700" />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 p-6">
            <div class="text-sm font-medium">THE DESERT</div>
            <div class="text-xs text-white/60">Time made visible</div>
          </div>
        </div>
        
        <div class="group relative overflow-hidden rounded-2xl aspect-video border border-white/10">
          <img src={summerImage} alt="Lush summer lake at golden hour — representing the 'good' summers we chase" class="w-full h-full object-cover transition-transform group-hover:scale-105 duration-700" />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 p-6">
            <div class="text-sm font-medium">THE GOOD SUMMERS</div>
            <div class="text-xs text-white/60">Light we carry forward</div>
          </div>
        </div>
        
        <div class="group relative overflow-hidden rounded-2xl aspect-video border border-white/10">
          <img src={filmReelImage} alt="Cinematic film reel and clapperboard — the medium through which 50 Good Summers will be told" class="w-full h-full object-cover transition-transform group-hover:scale-105 duration-700" />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 p-6">
            <div class="text-sm font-medium">35MM + ANAMORPHIC</div>
            <div class="text-xs text-white/60">Organic imperfection</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DEVELOPMENT STATUS -->
  <section id="development" class="max-w-5xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-12 gap-x-12">
      <div class="md:col-span-5">
        <div class="sticky top-24">
          <div class="uppercase tracking-[3px] text-xs text-[#d4af37] mb-3">CHAPTER IV</div>
          <h2 class="text-[56px] leading-none tracking-tighter font-bold mb-8">IN<br>DEVELOPMENT</h2>
          
          <div class="space-y-8 text-sm">
            <div>
              <div class="text-[#d4af37] tracking-widest text-xs mb-1">CURRENT STATUS</div>
              <div class="text-2xl font-semibold">Third Draft Complete</div>
            </div>
            <div>
              <div class="text-[#d4af37] tracking-widest text-xs mb-1">NEXT MILESTONE</div>
              <div class="text-2xl font-semibold">Table Read &amp; Producer Attachments</div>
            </div>
            <div>
              <div class="text-[#d4af37] tracking-widest text-xs mb-1">TARGET</div>
              <div class="text-2xl font-semibold">Principal Photography — Summer 2027</div>
            </div>
          </div>
        </div>
      </div>

      <div class="md:col-span-7 mt-16 md:mt-0">
        <div class="space-y-px">
          <div class="flex justify-between items-center py-6 border-b border-white/10 group">
            <div class="flex items-center gap-x-4">
              <div class="w-9 h-px bg-[#d4af37]"></div>
              <span class="font-medium">Concept &amp; Logline</span>
            </div>
            <span class="text-xs px-3 py-1 rounded bg-emerald-950 text-emerald-400 tracking-widest">COMPLETE</span>
          </div>
          
          <div class="flex justify-between items-center py-6 border-b border-white/10 group">
            <div class="flex items-center gap-x-4">
              <div class="w-9 h-px bg-[#d4af37]"></div>
              <span class="font-medium">First Draft</span>
            </div>
            <span class="text-xs px-3 py-1 rounded bg-emerald-950 text-emerald-400 tracking-widest">COMPLETE</span>
          </div>
          
          <div class="flex justify-between items-center py-6 border-b border-white/10 group">
            <div class="flex items-center gap-x-4">
              <div class="w-9 h-px bg-[#d4af37]"></div>
              <span class="font-medium">Second Draft (Director's Cut)</span>
            </div>
            <span class="text-xs px-3 py-1 rounded bg-emerald-950 text-emerald-400 tracking-widest">COMPLETE</span>
          </div>
          
          <div class="flex justify-between items-center py-6 border-b border-white/10 group">
            <div class="flex items-center gap-x-4">
              <div class="w-9 h-px bg-[#d4af37]"></div>
              <span class="font-medium">Third Draft — Current</span>
            </div>
            <span class="text-xs px-3 py-1 rounded bg-amber-950 text-amber-400 tracking-widest">IN PROGRESS</span>
          </div>
          
          <div class="flex justify-between items-center py-6 border-b border-white/10 group opacity-60">
            <div class="flex items-center gap-x-4">
              <div class="w-9 h-px bg-white/30"></div>
              <span class="font-medium">Producer / Director Attachments</span>
            </div>
            <span class="text-xs px-3 py-1 rounded bg-white/10 text-white/50 tracking-widest">Q3 2026</span>
          </div>
        </div>

        <div class="mt-12 p-8 bg-[#111] rounded-3xl border border-white/10 text-sm leading-relaxed text-[#b8ad95]">
          <p class="font-medium text-[#d4af37] mb-3">WRITER'S NOTE</p>
          <p>
            This screenplay was written with the belief that great cinema doesn't just entertain — it reminds us how to live. Every page has been crafted to feel like a summer you wish would never end.
          </p>
          <p class="mt-4 text-xs">— Eric R. Gutierrez, Writer &amp; Creator</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE 50 SUMMERS VISUAL -->
  <section class="py-16 border-t border-white/10 bg-black">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="max-w-md mx-auto mb-12">
        <div class="uppercase tracking-[3px] text-xs text-[#d4af37] mb-4">A FINITE RESOURCE</div>
        <h3 class="text-4xl tracking-tight font-semibold">You have exactly 50 good summers.<br>How many have you lived well?</h3>
      </div>

      <!-- Animated summer counter -->
      <div class="flex justify-center gap-1 md:gap-2 flex-wrap max-w-[620px] mx-auto mb-4" id="summer-grid">
        {Array.from({ length: 50 }).map((_, i) => (
          <div 
            class={`summer-count w-3.5 h-3.5 md:w-4 md:h-4 rounded-full border transition-all duration-300 ${i < 28 ? 'bg-[#d4af37] border-[#d4af37]' : 'border-white/20 hover:border-[#d4af37]/50'}`}
            data-index={i}
          ></div>
        ))}
      </div>
      <p class="text-xs tracking-widest text-white/40">28 summers lived • 22 remaining (example for age 42)</p>
    </div>
  </section>

  <!-- ACQUIRE SECTION -->
  <section id="acquire" class="max-w-3xl mx-auto px-6 py-24 text-center border-t border-white/10">
    <div class="mx-auto max-w-xl">
      <div class="uppercase tracking-[3px] text-xs text-[#d4af37] mb-6">FINAL CHAPTER</div>
      
      <h2 class="text-6xl tracking-tighter font-bold leading-none mb-8">Bring 50 Good Summers<br>to the World</h2>
      
      <p class="text-xl text-[#c9b89a] mb-12">
        This is more than a script. It is an invitation to create something timeless.<br>
        We are seeking visionary producers and directors ready to turn this story into a landmark American film.
      </p>

      <div class="bg-[#111] border border-[#d4af37]/30 rounded-3xl p-12 mb-8">
        <div class="text-sm tracking-widest text-[#d4af37] mb-2">ACQUISITION INQUIRIES</div>
        <a 
          href="mailto:sales@desertrich.com?subject=Acquisition%20Inquiry%20-%2050%20Good%20Summers&amp;body=Hello%2C%0A%0AI%20am%20interested%20in%20acquiring%20the%20rights%20to%2050%20Good%20Summers.%0A%0APlease%20send%20me%20the%20latest%20draft%20and%20terms.%0A%0ABest%20regards%2C%0A%5BYour%20Name%5D"
          class="cta-button inline-flex w-full justify-center items-center gap-x-4 px-10 py-5 text-base rounded-2xl mt-4"
        >
          EMAIL SALES@DESERTRICH.COM
          <span class="text-xl">✉︎</span>
        </a>
        
        <p class="text-[10px] text-white/40 mt-6 tracking-widest">RESPONSES WITHIN 48 HOURS • CONFIDENTIAL</p>
      </div>

      <div class="text-xs text-white/50 max-w-xs mx-auto">
        All rights available. Worldwide. Including remake, sequel, and television rights.
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-white/10 bg-[#050505] py-16">
    <div class="max-w-5xl mx-auto px-6 grid md:grid-cols-2 gap-y-12">
      <div>
        <div class="flex items-center gap-x-3 mb-6">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#d4af37] to-[#b8972e] flex items-center justify-center">
            <span class="text-[#0a0a0a] text-lg font-bold tracking-tighter">50</span>
          </div>
          <span class="font-semibold tracking-[2px]">50 GOOD SUMMERS</span>
        </div>
        
        <div class="text-sm text-white/50 max-w-xs">
          An original feature film screenplay by Eric R. Gutierrez.<br>
          © 2025–2026 Desert Rich Productions. All rights reserved.
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-y-8 text-sm">
        <div>
          <div class="text-white/40 text-xs tracking-widest mb-3">PROJECT</div>
          <div class="space-y-1.5 text-white/80">
            <a href="#story" class="block hover:text-white">The Story</a>
            <a href="#premise" class="block hover:text-white">The Premise</a>
            <a href="#development" class="block hover:text-white">Development</a>
          </div>
        </div>
        <div>
          <div class="text-white/40 text-xs tracking-widest mb-3">LEGAL</div>
          <div class="space-y-1.5 text-white/80">
            <a href="#" class="block hover:text-white">Privacy</a>
            <a href="#" class="block hover:text-white">Terms</a>
            <a href="mailto:sales@desertrich.com" class="block hover:text-white">Contact</a>
          </div>
        </div>
        <div class="md:col-span-1 col-span-2">
          <div class="text-white/40 text-xs tracking-widest mb-3">CONNECT</div>
          <div class="flex gap-x-5 text-white/80">
            <a href="https://github.com/Mrerg7/50goodsummers_com_v1" target="_blank" class="hover:text-white">GitHub</a>
            <a href="https://x.com/ERG963" target="_blank" class="hover:text-white">X</a>
          </div>
          <div class="mt-8 text-[10px] text-white/30">Built with Astro • Deployed on Cloudflare Pages • Images via Cloudflare CDN</div>
        </div>
      </div>
    </div>

    <div class="mt-20 pt-8 border-t border-white/10 text-center text-[10px] text-white/30 tracking-widest">
      MADE WITH PURPOSE IN THE DESERT • FOR THE ONES WHO STILL BELIEVE IN GOOD SUMMERS
    </div>
  </footer>
</Layout>

<!-- Mobile Menu Script -->
<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  if (mobileBtn) {
    mobileBtn.addEventListener('click', () => {
      const nav = document.querySelector('nav');
      if (nav) {
        nav.classList.toggle('!bg-black');
        // Simple mobile nav expansion could be added here
        alert('Mobile navigation expanded (demo). In production, implement a full slide-in menu.');
      }
    });
  }

  // Summer counter interaction
  document.addEventListener('DOMContentLoaded', () => {
    const summers = document.querySelectorAll('#summer-grid > div');
    summers.forEach((dot, index) => {
      dot.addEventListener('mouseenter', () => {
        summers.forEach((d, i) => {
          if (i <= index) {
            d.classList.add('!bg-[#d4af37]', '!border-[#d4af37]');
            d.classList.remove('border-white/20');
          }
        });
      });
      
      dot.addEventListener('mouseleave', () => {
        summers.forEach((d, i) => {
          if (i < 28) { // reset to default 28 filled
            d.classList.add('bg-[#d4af37]', 'border-[#d4af37]');
            d.classList.remove('border-white/20');
          } else {
            d.classList.remove('!bg-[#d4af37]', '!border-[#d4af37]');
            d.classList.add('border-white/20');
          }
        });
      });
    });
  });

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const targetId = this.getAttribute('href')?.substring(1);
      const targetElement = document.getElementById(targetId);
      if (targetElement) {
        e.preventDefault();
        const navHeight = 80;
        const elementPosition = targetElement.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.scrollY - navHeight;

        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
      }
    });
  });
</script>