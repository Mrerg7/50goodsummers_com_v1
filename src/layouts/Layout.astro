---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = "50 Good Summers | A Cinematic Story in Development",
  description = "As long as you live and how you live, you are only granted 50 good summers, no more, no less. An original movie script in active development. Acquire the rights today.",
  image = "https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/72e73044-e440-451c-1245-ad5a17d17f00/public",
  canonical: explicitCanonical,
} = Astro.props;

// Dynamically derive canonical from Astro.url to match the actual page URL,
// preventing "Alternate page with proper canonical tag" indexing issues.
const canonical = explicitCanonical || new URL(Astro.url.pathname, Astro.site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Movie",
  "name": "50 Good Summers",
  "description": "A powerful cinematic drama exploring the finite beauty of life through the lens of 50 precious summers. Currently in development as an original feature film screenplay.",
  "url": "https://50goodsummers.com",
  "image": image,
  "genre": ["Drama", "Philosophical", "Character Study"],
  "director": { "@type": "Person", "name": "TBD" },
  "author": { "@type": "Person", "name": "Eric R. Gutierrez" },
  "productionCompany": { "@type": "Organization", "name": "Desert Rich Productions" },
  "inProduction": true,
  "dateCreated": "2025",
  "keywords": "50 good summers, movie script, film development, life reflection, mortality, summer stories, cinematic drama",
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "price": "Contact for acquisition",
    "priceCurrency": "USD",
    "url": "mailto:sales@desertrich.com"
  }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="U6FcNmeIDQIsYubiHOOAwe7vhMSoQUtSXvjSK4_uGnI" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="50 good summers, movie script, film in development, cinematic story, life is short, 50 summers, screenplay, feature film, desert rich, eric gutierrez" />
    <meta name="author" content="Eric R. Gutierrez" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="50 Good Summers" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <meta property="twitter:creator" content="@ERG963" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://imagedelivery.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0a0a0a] text-[#f5f5f5] font-sans overflow-x-hidden">
    <slot />
  </body>
</html>
