---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="desertrich.com — Domain Available"
  description="desertrich.com is available for acquisition. A premium, one-word .com domain with strong brand potential. Contact for pricing."
  canonical="https://50goodsummers.com/desertrich/"
>
  <main class="min-h-screen flex flex-col items-center justify-center px-6 bg-[#0a0a0a] relative overflow-hidden">

    <!-- Subtle grid texture -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(212,175,55,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(212,175,55,0.03)_1px,transparent_1px)] bg-[size:80px_80px] pointer-events-none"></div>

    <!-- Faint radial glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#d4af37]/5 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative z-10 text-center max-w-lg">

      <!-- Domain badge -->
      <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-full border border-white/10 bg-white/5 mb-10">
        <span class="w-1.5 h-1.5 rounded-full bg-[#d4af37] inline-block"></span>
        <span class="text-[11px] tracking-[3px] text-white/50 uppercase">Domain Available</span>
      </div>

      <!-- Domain name -->
      <h1 class="text-[56px] md:text-[72px] font-bold tracking-tighter leading-none mb-3 text-white">
        desert<span class="text-[#d4af37]">rich</span><span class="text-white/30">.com</span>
      </h1>

      <!-- Subtle descriptor -->
      <p class="text-[13px] tracking-[2px] text-white/30 uppercase mb-14">
        Premium one-word domain &nbsp;&middot;&nbsp; Currently in active use
      </p>

      <!-- Divider -->
      <div class="w-16 h-px bg-[#d4af37]/30 mx-auto mb-14"></div>

      <!-- The ask -->
      <p class="text-[15px] text-white/50 leading-relaxed mb-10 max-w-sm mx-auto">
        Serious inquiries only. If you have a compelling vision for this domain, reach out directly.
      </p>

      <!-- CTA -->
      <a
        href="mailto:sales@desertrich.com?subject=Domain%20Acquisition%20Inquiry%20%E2%80%94%20desertrich.com&body=Hello%2C%0A%0AI%20am%20interested%20in%20acquiring%20the%20domain%20desertrich.com.%0A%0APlease%20share%20your%20asking%20price%20and%20terms.%0A%0ABest%2C%0A%5BYour%20Name%5D"
        class="group inline-flex items-center gap-x-3 px-8 py-3.5 rounded-full border border-white/15 text-white/60 hover:border-[#d4af37]/40 hover:text-white/90 transition-all duration-300 text-[13px] tracking-[1.5px] uppercase"
      >
        <span>Inquire via Email</span>
        <svg class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </a>

      <!-- Email shown -->
      <p class="mt-5 text-[11px] text-white/20 tracking-widest">
        SALES@DESERTRICH.COM
      </p>
    </div>

    <!-- Back link -->
    <a
      href="/"
      class="absolute bottom-10 left-1/2 -translate-x-1/2 text-[11px] tracking-[3px] text-white/20 hover:text-white/50 transition-colors uppercase"
    >
      &larr; 50goodsummers.com
    </a>
  </main>
</Layout>
