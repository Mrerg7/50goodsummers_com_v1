---
import Layout from '../layouts/Layout.astro';
import PageChrome from '../components/PageChrome.astro';

const faqs = [
  {
    q: 'What is 50 Good Summers?',
    a: '50 Good Summers is an original feature film screenplay — a meditative, emotionally devastating, and ultimately life-affirming drama about the quiet mathematics of a life well-lived. It is written and created by Eric R. Gutierrez and presented by Desert Rich Productions.',
  },
  {
    q: 'What stage of development is the screenplay in?',
    a: 'The project has a complete concept and logline, a completed first draft, a completed second draft (director’s cut), and a current third draft of 118 pages. The next milestones are a table read and producer/director attachments, with principal photography targeted for summer 2027.',
  },
  {
    q: 'What rights are available for acquisition?',
    a: 'All rights are available worldwide, including remake, sequel, and television rights. The screenplay can be acquired outright or developed with attaching producers and directors — inquiries for either path are welcome.',
  },
  {
    q: 'How do producers, directors, or financiers inquire?',
    a: 'Email sales@desertrich.com with the subject line “Acquisition Inquiry – 50 Good Summers.” Include a short note about who you are and how you’d like to engage with the project. Confidential responses are typically returned within 48 hours.',
  },
  {
    q: 'Is the full script available for review?',
    a: 'Yes — the current draft is shared with serious, qualified inquiries under standard confidentiality. Request it by email and you will receive the latest draft and terms.',
  },
  {
    q: 'Where is the story set?',
    a: 'The story is set against the vast, unforgiving beauty of the American Southwest. The desert functions as both antagonist and sanctuary, and the visual language is built around 35mm film, golden hour, and anamorphic photography.',
  },
  {
    q: 'What is the logline of 50 Good Summers?',
    a: 'When a man learns he has only a handful of summers left, he sets out to transform his remaining time into a legacy of meaning — before the sun sets on his final season.',
  },
  {
    q: 'Who wrote 50 Good Summers?',
    a: 'Eric R. Gutierrez is the writer and creator. Desert Rich Productions is the production company presenting the project. Learn more on the About page.',
  },
];

const structuredData = [
  {
    '@type': 'FAQPage',
    '@id': 'https://50goodsummers.com/faq/#webpage',
    url: 'https://50goodsummers.com/faq/',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://50goodsummers.com/' },
      { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://50goodsummers.com/faq/' },
    ],
  },
];
---

<Layout
  title="FAQ — 50 Good Summers Screenplay Rights & Acquisition"
  description="Answers on the 50 Good Summers screenplay: development status, rights availability, how to request the script, and how producers and directors can inquire."
  canonical="https://50goodsummers.com/faq/"
  structuredData={structuredData}
>
  <PageChrome crumbs={[{ label: 'FAQ' }]}>
    <article class="max-w-3xl mx-auto px-6 py-14 md:py-20">
      <div class="uppercase tracking-[3px] text-xs text-[#d4af37] mb-4">Acquisition FAQ</div>
      <h1 class="text-5xl md:text-6xl leading-none tracking-tighter font-bold mb-6">
        Frequently<br />Asked Questions
      </h1>
      <div class="gold-line w-20 mb-10"></div>
      <p class="text-xl text-[#c9b89a] leading-snug mb-12">
        Everything producers, directors, and financiers need to know about
        <span class="font-semibold text-[#d4af37]">50 Good Summers</span> — rights, drafts,
        and how to start a conversation.
      </p>

      <div class="space-y-4">
        {
          faqs.map((item) => (
            <details class="group bg-[#111] border border-white/10 rounded-2xl overflow-hidden">
              <summary class="cursor-pointer list-none px-6 py-5 md:px-8 flex items-start justify-between gap-x-4 text-white hover:text-[#d4af37] transition-colors">
                <span class="font-medium text-[17px] leading-snug">{item.q}</span>
                <span class="text-[#d4af37] shrink-0 mt-1 transition-transform group-open:rotate-45 text-xl leading-none">
                  +
                </span>
              </summary>
              <div class="px-6 pb-6 md:px-8 text-[15px] leading-relaxed text-[#b8ad95]">
                {item.a}
              </div>
            </details>
          ))
        }
      </div>

      <div class="bg-[#111] border border-[#d4af37]/30 rounded-3xl p-8 md:p-10 text-center mt-12">
        <div class="text-xs tracking-widest text-[#d4af37] mb-3">STILL HAVE QUESTIONS?</div>
        <p class="text-[#c9b89a] mb-6">Responses within 48 hours. Confidential.</p>
        <a
          href="mailto:sales@desertrich.com?subject=Acquisition%20Inquiry%20-%2050%20Good%20Summers"
          class="cta-button inline-flex items-center justify-center px-8 py-3.5 rounded-full"
        >
          EMAIL SALES@DESERTRICH.COM ✉︎
        </a>
      </div>
    </article>
  </PageChrome>
</Layout>
