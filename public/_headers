# Canonical enforcement for root — required for GSC to resolve canonical
/
  Link: <https://50goodsummers.com/>; rel="canonical"

# Sitemap content-type — ensures proper XML serving
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# Security & performance
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Long-lived caching for build assets
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Prevent indexing of 404 page
/404.html
  X-Robots-Tag: noindex
